{
  "expo": {
    "name": "Cleaning Hero",
    "slug": "tank-cleaning-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpeg",
    "scheme": "tankcleaning",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tankcleaning.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of tank before and after cleaning",
        "NSPhotoLibraryUsageDescription": "Select photos from your library",
        "NSLocationWhenInUseUsageDescription": "Track location during active jobs",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Track your location during jobs",
        "NSLocationAlwaysUsageDescription": "Track location in background"
      }
    },
    "android": {
      "package": "com.tankcleaning.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpeg",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Tank Cleaning App to track your location during active jobs.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tank Cleaning App to access your camera to take before and after photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39b0c118-f3a0-4c8a-aef2-46cb661b1e71"
      }
    },
    "owner": "shivamraj2004"
  }
}
